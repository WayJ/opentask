# ChatApp 生产环境配置示例
# 复制为 .env.prod 并填入真实值（.env.prod 已被 .gitignore 忽略，不会提交）

# Anthropic API Key（示例为智谱 BigModel 的 Anthropic 兼容端点）
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# 数据库配置（与主平台共用用户系统）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=opentask

# 主平台 API（用于验证用户 token）
VIBEKING_API_URL=http://localhost:8000/opentask/
