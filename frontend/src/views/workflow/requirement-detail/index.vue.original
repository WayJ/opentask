.task-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.task-left-info {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* 任务编号 */
.task-code {
  font-size: 11px;
  font-weight: 600;
  color: #94a3b8;
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
  letter-spacing: 0.5px;
}

/* 状态徽章 */
.task-status-badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: all 0.2s ease;
}

.task-status-badge.status-pending {
  background: #f1f5f9;
  color: #64748b;
}

.task-status-badge.status-assigned {
  background: #dbeafe;
  color: #1d4ed8;
}

.task-status-badge.status-running {
  background: #fef3c7;
  color: #d97706;
}

.task-status-badge.status-completed {
  background: #d1fae5;
  color: #059669;
}

.task-status-badge.status-failed {
  background: #fee2e2;
  color: #dc2626;
}

.task-status-badge.status-blocked {
  background: #ede9fe;
  color: #7c3aed;
}

.task-status-badge.status-cancelled {
  background: #f3f4f6;
  color: #4b5563;
}

/* 类型徽章 */
.task-type-badge {
  padding: 4px 10px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 11px;
  font-weight: 600;
  border-radius: 6px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 2px 4px rgba(102, 126, 234, 0.2);
}

/* 任务标题 */
.task-title-heading {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.4;
  letter-spacing: -0.01em;
}

/* 任务描述 */
.task-description {
  color: #64748b;
  line-height: 1.6;
  font-size: 14px;
}

.task-description p:last-child {
  margin-bottom: 0;
}

/* 文档区域 */
.task-documents-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  background: #f8fafc;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
}

.task-documents-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.document-icon,
.subtasks-icon {
  font-size: 16px;
  color: #64748b;
  vertical-align: middle;
}

.task-documents-count {
  background: #e2e8f0;
  color: #475569;
  padding: 2px 6px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 600;
}

.task-document-links {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.task-document-link {
  color: #0891b2;
  text-decoration: none;
  font-size: 13px;
  padding: 6px 10px;
  border-radius: 6px;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  font-weight: 500;
  border: 1px solid transparent;
  position: relative;
}

.task-document-link::before {
  content: '📄';
  margin-right: 6px;
  font-size: 12px;
}

.task-document-link:hover {
  background: #ecfeff;
  color: #0e7490;
  border-color: #cbd5e1;
  transform: translateX(4px);
  box-shadow: 0 2px 4px rgba(8, 145, 178, 0.1);
}

/* 子任务区域 */
.subtasks-section {
  margin-top: 4px;
  padding: 12px;
  background: #fefce8;
  border-radius: 8px;
  border: 1px solid #fef08a;
}

.subtasks-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: #854d0e;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 8px;
}

.subtasks-collapse :deep(.n-collapse-item) {
  background: transparent;
  border: none;
}

.subtasks-collapse :deep(.n-collapse-item__header) {
  padding: 0;
  font-size: 13px;
  font-weight: 500;
  color: #713f12;
}

/* 操作栏 */
.task-actions-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-top: 12px;
  border-top: 1px solid #f1f5f9;
  margin-top: 4px;
}

.task-primary-actions {
  display: flex;
  gap: 8px;
}

.task-secondary-actions {
  display: flex;
  gap: 4px;
}

/* MarkdownRenderer 在任务卡片中的样式覆盖 */
.task-card-main .markdown-renderer {
  color: #64748b;
  line-height: 1.6;
  font-size: 14px;
}

.task-card-main .markdown-renderer :deep(p:last-child) {
  margin-bottom: 0;
}

.task-card-main .markdown-renderer :deep(h1),
.task-card-main .markdown-renderer :deep(h2),
.task-card-main .markdown-renderer :deep(h3),
.task-card-main .markdown-renderer :deep(h4),
.task-card-main .markdown-renderer :deep(h5),
.task-card-main .markdown-renderer :deep(h6) {
  margin: 0.5em 0 0.25em 0;
  font-weight: 600;
  line-height: 1.4;
  color: #334155;
}

.task-card-main .markdown-renderer :deep(h1) {
  font-size: 1.25em;
}

.task-card-main .markdown-renderer :deep(h2) {
  font-size: 1.15em;
}

.task-card-main .markdown-renderer :deep(h3) {
  font-size: 1.05em;
}

.task-card-main .markdown-renderer :deep(p) {
  margin: 0.25em 0;
}

.task-card-main .markdown-renderer :deep(ul),
.task-card-main .markdown-renderer :deep(ol) {
  margin: 0.25em 0;
  padding-left: 1.5em;
}

.task-card-main .markdown-renderer :deep(li) {
  margin: 0.1em 0;
}

.task-card-main .markdown-renderer :deep(code) {
  background-color: rgba(0, 0, 0, 0.06);
  padding: 2px 4px;
  border-radius: 3px;
  font-size: 0.9em;
  font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
}

.task-card-main .markdown-renderer :deep(pre) {
  background-color: #f5f5f5;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  padding: 8px;
  overflow-x: auto;
  margin: 0.5em 0;
}

.task-card-main .markdown-renderer :deep(pre code) {
  background-color: transparent;
  padding: 0;
  border-radius: 0;
}

.task-card-main .markdown-renderer :deep(a) {
  color: #0891b2;
  text-decoration: none;
}

.task-card-main .markdown-renderer :deep(a:hover) {
  text-decoration: underline;
}

.task-card-main .markdown-renderer :deep(blockquote) {
  border-left: 3px solid #18a058;
  padding-left: 0.75em;
  margin: 0.5em 0;
  color: #666;
}
</style>
