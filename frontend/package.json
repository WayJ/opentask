{
  "name": "soybean-admin",
  "type": "module",
  "version": "2.0.2",
  "description": "A fresh and elegant admin template, based on Vue3、Vite7、TypeScript、NaiveUI and UnoCSS. 一个基于Vue3、Vite7、TypeScript、NaiveUI and UnoCSS的清新优雅的中后台模版。",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/soybeanjs/soybean-admin",
  "repository": {
    "url": "https://github.com/soybeanjs/soybean-admin.git"
  },
  "bugs": {
    "url": "https://github.com/soybeanjs/soybean-admin/issues"
  },
  "keywords": [
    "Vue3 admin ",
    "vue-admin-template",
    "Vite7",
    "TypeScript",
    "naive-ui",
    "naive-ui-admin",
    "ant-design-vue v4",
    "UnoCSS"
  ],
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "gen-route": "sa gen-route",
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@guolao/vue-monaco-editor": "^1.5.2",
    "@iconify/vue": "5.0.0",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "14.1.0",
    "clipboard": "2.0.11",
    "crypto-js": "^4.2.0",
    "dayjs": "1.11.19",
    "defu": "6.1.4",
    "echarts": "6.0.0",
    "highlight.js": "^11.11.1",
    "json5": "2.2.3",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-katex": "^1.0.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "naive-ui": "2.43.2",
    "node-forge": "1.3.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "tailwind-merge": "3.4.0",
    "vditor": "^3.11.2",
    "vue": "3.5.27",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.2.8",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.430",
    "@iconify/utils": "^2.3.0",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config": "1.7.5",
    "@types/crypto-js": "^4.2.2",
    "@types/highlight.js": "^10.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "25.0.9",
    "@types/node-forge": "1.3.11",
    "@types/nprogress": "0.2.3",
    "@unocss/eslint-config": "66.6.0",
    "@unocss/preset-icons": "66.6.0",
    "@unocss/preset-uno": "66.6.0",
    "@unocss/preset-wind3": "66.6.0",
    "@unocss/transformer-directives": "66.6.0",
    "@unocss/transformer-variant-group": "66.6.0",
    "@unocss/vite": "66.6.0",
    "@vitejs/plugin-vue": "6.0.3",
    "@vitejs/plugin-vue-jsx": "5.1.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "consola": "3.4.2",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.7.0",
    "happy-dom": "^20.8.4",
    "kolorist": "1.8.0",
    "prettier-plugin-json-sort": "^0.0.2",
    "sass": "1.97.2",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "31.0.0",
    "vite": "7.3.1",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.0.5",
    "vite-plugin-vue-transition-root-validator": "^0.0.4",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.2.2"
  },
  "simple-git-hooks": {
    "commit-msg": "bun sa git-commit-verify",
    "pre-commit": "bun typecheck && bun lint && git diff --exit-code"
  },
  "website": "https://admin.soybeanjs.cn"
}
