# OpenTask 前端镜像（**预构建产物**版）
#
#   # 构建上下文需包含 dist/ 与 nginx.conf（deploy/deploy.sh 会临时组装）
#   docker buildx build --platform linux/amd64 \
#       -f frontend/Dockerfile.dist -t opentask-frontend:prod --load <context>
#
# 为什么需要这一份：生产服务器内存只有 1.6GB 且无 swap，跑不动
# `pnpm install + vite build`（vite 是内存大户，构建期极易 OOM）。
# 于是改为在开发机上构建出 dist，再把 dist 打进镜像送达服务器。
#
# 本文件只有 COPY（+ 一次 rm），没有编译步骤：buildx 拉取 linux/amd64 的
# nginx 基础镜像后无需 QEMU 模拟，交叉构建几乎不耗时。
#
# 与 frontend/Dockerfile（源码构建版）的产物形态必须一致：
#   dist → /usr/share/nginx/html/，nginx.conf 同名同内容。
# 两者的等价性由 deploy/deploy.sh 的校验步骤保证。

FROM nginx:1.27-alpine

# 删掉基础镜像自带的默认首页
RUN rm -f /usr/share/nginx/html/index.html /usr/share/nginx/html/50x.html

COPY dist/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/login >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
