    "/tasks/token": {
      "post": {
        "tags": [
          "任务源契约 (Task Source Contract)"
        ],
        "summary": "Issue Contract Token",
        "description": "OAuth2 client credentials 换 token（公开端点，凭证即 API Key）\n\n- grant_type=client_credentials（固定值）\n- client_secret：``vk_`` API Key（必填）\n- client_id：可选，提供时须为该 Key 归属用户 ID\n返回 ``{access_token, token_type: \"Bearer\", expires_in}``（不下发 refresh）。",
        "operationId": "issue_contract_token_tasks_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_issue_contract_token_tasks_token_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "不支持的 grant_type（CONTRACT_AUTH_UNSUPPORTED_GRANT）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "缺凭证/凭证无效（CONTRACT_AUTH_MISSING / CONTRACT_AUTH_INVALID）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "后端依赖（数据库）不可达（CONTRACT_UNAVAILABLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "tags": [
          "任务源契约 (Task Source Contract)"
        ],
        "summary": "Capabilities",
        "description": "契约能力声明：端点支持情况 + 契约版本 + 鉴权模式 + 生效状态词表\n\n无需凭证（对接前探测用）；不含敏感信息，仅描述契约形状。",
        "operationId": "capabilities_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractCapabilities"
                }
              }
            }
          }
        }
      }
    }
