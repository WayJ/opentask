        "title": "ContractErrorDetail",
        "description": "契约层错误体（S6 定稿：code + message 可读字段）\n\n所有契约层语义错误（401/403/404/422 词表违规/503）的 ``detail``\n均为此形状；结构性 schema 违例仍为 FastAPI 标准校验体。"
      },
      "ContractErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ContractErrorDetail",
            "description": "错误码与可读消息"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ContractErrorResponse",
        "description": "契约层错误响应（完整 body：{\"detail\": {code, message}}）"
      },
